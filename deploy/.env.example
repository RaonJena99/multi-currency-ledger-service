# cp .env.example .env 후 값을 채운다. .env 는 커밋하지 않는다.

# 배포할 이미지 버전. 비우면 latest.
APP_VERSION=
# 호스트에 노출할 애플리케이션 포트
APP_PORT=8080

# 필수: DB 비밀번호 (PostgreSQL 초기화와 애플리케이션 접속에 함께 쓰인다)
DB_PASSWORD=
# 필수: API 게이트웨이와 공유하는 비밀값. 게이트웨이는 X-Gateway-Secret 헤더에 같은 값을 실어 보내야 한다.
GATEWAY_SHARED_SECRET=

# 필수: Grafana 관리자(admin) 비밀번호
GRAFANA_ADMIN_PASSWORD=

# 선택: 서버 자신(127.0.0.1)에서만 열리는 모니터링 포트
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# 선택: 시세 API 키 (없으면 무료 플랜 한도로 동작)
EXCHANGE_RATE_API_KEY=
CRYPTO_PRICE_API_KEY=
