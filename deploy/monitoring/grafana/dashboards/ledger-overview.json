    {
      "type": "timeseries",
      "title": "서킷 브레이커 열림",
      "description": "1 이면 호출 차단 중. 5분 넘게 이어지면 CircuitBreakerOpen 알림",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
